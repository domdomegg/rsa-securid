    "prepublishOnly": "echo \"Use \\\"npm run publish\\\" instead!\" && exit 1"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:domdomegg/rsa-securid.git"
  },
  "sideEffects": false
}
