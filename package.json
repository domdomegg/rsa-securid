{
  "name": "rsa-securid",
  "version": "2.0.8",
  "description": "Node.js RSA SecurID-compatible token library",
  "license": "LGPL-2.1-or-later",
  "author": "Adam Jones (domdomegg)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
